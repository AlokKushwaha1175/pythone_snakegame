name: Build & Deploy Flask App (STAG)

on:
  push:
    branches:
      - stag

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Code
      uses: actions/checkout@v4

    - name: Login to Docker Hub
      uses: docker/login-action@v3
      with:
        username: ${{ secrets.DOCKERHUB_USERNAME }}
        password: ${{ secrets.DOCKERHUB_TOKEN }}

    - name: Build & Push Docker Image
      run: |
        docker build -t ${{ secrets.DOCKERHUB_USERNAME }}/flask-app:stag .
        docker push ${{ secrets.DOCKERHUB_USERNAME }}/flask-app:stag

    - name: Setup SSH
      run: |
        mkdir -p ~/.ssh
        echo "${{ secrets.EC2_SSH_KEY }}" > ~/.ssh/id_rsa
        chmod 600 ~/.ssh/id_rsa
        ssh-keyscan -H ${{ secrets.EC2_HOST }} >> ~/.ssh/known_hosts

    - name: Pull & Run Image on EC2
      run: |
        ssh ${{ secrets.EC2_USER }}@${{ secrets.EC2_HOST }} << 'EOF'
          set -e

          docker pull ${{ secrets.DOCKERHUB_USERNAME }}/flask-app:stag

          docker stop flask-stag || true
          docker rm flask-stag || true

          docker run -d \
            --name flask-stag \
            -p 6000:5000 \
            --restart always \
            ${{ secrets.DOCKERHUB_USERNAME }}/flask-app:stag

          docker image prune -f
        EOF
